+def _unified_memory_trace(stage: str, module=None, dtype=None):
+    """Emit opt-in dtype/device memory evidence for the unified-model smoke."""
+    if os.getenv("AGENTFLOW_UNIFIED_MEMORY_LOG", "0").lower() not in {"1", "true", "yes", "on"}:
+        return
+    if dist.is_initialized() and dist.get_rank() != 0:
+        return
+    device = get_torch_device()
+    free, total = device.mem_get_info()
+    dtypes = sorted({str(param.dtype) for param in module.parameters()}) if module is not None else []
+    print(
+        "UNIFIED_FSDP_MEMORY "
+        f"stage={stage} requested_dtype={dtype} module_dtypes={dtypes} "
+        f"allocated_gib={device.memory_allocated() / (1024**3):.3f} "
+        f"reserved_gib={device.memory_reserved() / (1024**3):.3f} "
+        f"device_used_gib={(total - free) / (1024**3):.3f} "
+        f"device_total_gib={total / (1024**3):.3f}",
+        flush=True,
+    )
+
+
