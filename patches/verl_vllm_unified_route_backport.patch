+def _publish_unified_lora_route(lora_name: str, lora_int_id: int) -> None:
+    """Publish only adapter identity for the AgentFlow HTTP role bridge."""
+    path = os.getenv("AGENTFLOW_ROLE_ROUTING_STATE", "").strip()
+    if not path:
+        return
+    payload = {
+        "schema_version": 1,
+        "base_role": "qwen-base",
+        "actor_role": "qwen-actor",
+        "base_model": os.getenv("AGENTFLOW_UNIFIED_BASE_MODEL_NAME", "qwen-base"),
+        "actor": {
+            "lora_name": str(lora_name),
+            "lora_int_id": int(lora_int_id),
+            "version": str(time.time_ns()),
+        },
+    }
+    target_dir = os.path.dirname(path) or "."
+    os.makedirs(target_dir, exist_ok=True)
+    fd, temporary = tempfile.mkstemp(prefix=".agentflow-role-route.", dir=target_dir)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as handle:
+            json.dump(payload, handle, sort_keys=True, separators=(",", ":"))
+            handle.write("\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, path)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+    logger.info(
+        "UNIFIED_ROLE_ROUTE published role=qwen-actor adapter_id=%s version=%s",
+        lora_int_id,
+        payload["actor"]["version"],
+    )
+
